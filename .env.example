# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (check AI Studio for what your free tier allows)
GEMINI_MODEL=gemini-2.5-flash
# Optional: shared cache (Upstash Redis via Vercel Marketplace). Falls back to a temp file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protects /api/cron (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
